{
  "version": 1,
  "role": "capture",
  "peer": {
    "ssh_host": "production-host",
    "ssh_port": 22,
    "control_port": 17870,
    "remote_control_port": 17871,
    "forward_control_port": 17872,
    "token_file": "~/.config/splitcast/control.token",
    "remote_token_file": "~/.config/splitcast/production.token",
    "state_dir": "~/.local/state/splitcast",
    "timeout_seconds": 15
  },
  "capture": {
    "target": "",
    "game_audio": "",
    "width": 1280,
    "height": 720,
    "fps": 60,
    "bitrate_kbps": 12000,
    "rtmp_port": 1935,
    "rtsp_port": 8554,
    "api_port": 9997
  },
  "audio": {
    "mic_source": "",
    "tts_sink": "",
    "tts_volume_percent": 100,
    "processed_sink": "splitcast_mic",
    "rnnoise_plugin": "/usr/lib/ladspa/librnnoise.so",
    "rnnoise_label": "noise_suppressor_mono",
    "rnnoise_control": "50|200|0|0|0",
    "gain_db": 0,
    "mic_offset_ms": 0
  },
  "obs": {
    "binary": "obs",
    "websocket_port": 4455,
    "password_file": "~/.config/splitcast/obs.password",
    "recording_dir": "~/Videos/SplitCast",
    "bitrate_kbps": 6000
  },
  "tts": {
    "enabled": false,
    "voicevox_url": "http://127.0.0.1:50021",
    "speaker": 3,
    "queue_limit": 16,
    "expiry_seconds": 60,
    "max_text": 200,
    "eventsub": false,
    "credentials_file": "~/.config/splitcast/twitch.json"
  }
}
